{
  "schema_version": 1,
  "id": "rules.zh-en.minimal",
  "version": 1,
  "pipeline_version": 2,
  "license": "Apache-2.0 OR MIT",
  "sample_pair": ["zh-Hans", "en"],
  "rules": [
    {
      "id": "norm.nfkc",
      "priority": 10,
      "language_pairs": [["*", "*"]],
      "action": { "kind": "nfkc" },
      "samples": [
        { "input": "ｃａｔ", "expect": "cat" },
        { "input": "ＡＢＣ", "expect": "ABC" }
      ]
    },
    {
      "id": "term.robot",
      "priority": 50,
      "language_pairs": [["zh-Hans", "en"]],
      "when": { "is_single_word": true },
      "action": { "kind": "replace", "from": "机器人", "to": "robot" },
      "samples": [{ "input": "机器人", "expect": "robot" }]
    },
    {
      "id": "term.llm",
      "priority": 60,
      "language_pairs": [["en", "zh-Hans"]],
      "action": {
        "kind": "replace",
        "from": "LLM",
        "to": "large language model",
        "whole_word": true
      },
      "samples": [
        {
          "input": "the LLM works",
          "expect": "the large language model works",
          "source": "en",
          "target": "zh-Hans"
        }
      ]
    }
  ]
}
