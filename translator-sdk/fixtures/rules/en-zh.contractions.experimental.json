{
  "schema_version": 1,
  "id": "rules.en-zh.contractions.experimental",
  "version": 1,
  "pipeline_version": 2,
  "license": "Apache-2.0 OR MIT",
  "sample_pair": [
    "en",
    "zh-Hans"
  ],
  "rules": [
    {
      "id": "norm.nfkc",
      "priority": 10,
      "language_pairs": [
        [
          "en",
          "zh-Hans"
        ]
      ],
      "action": {
        "kind": "nfkc"
      },
      "samples": [
        {
          "input": "ｃａｔ",
          "expect": "cat",
          "source": "en",
          "target": "zh-Hans"
        },
        {
          "input": "ＡＢＣ １２３",
          "expect": "ABC 123",
          "source": "en",
          "target": "zh-Hans"
        }
      ]
    },
    {
      "id": "norm.curly-apostrophe",
      "priority": 20,
      "language_pairs": [
        [
          "en",
          "zh-Hans"
        ]
      ],
      "action": {
        "kind": "replace",
        "from": "’",
        "to": "'",
        "whole_word": false
      },
      "samples": [
        {
          "input": "don’t stop",
          "expect": "don't stop",
          "source": "en",
          "target": "zh-Hans"
        }
      ]
    },
    {
      "id": "norm.curly-quote-open",
      "priority": 21,
      "language_pairs": [
        [
          "en",
          "zh-Hans"
        ]
      ],
      "action": {
        "kind": "replace",
        "from": "“",
        "to": "\"",
        "whole_word": false
      },
      "samples": [
        {
          "input": "say “hello now",
          "expect": "say \"hello now",
          "source": "en",
          "target": "zh-Hans"
        }
      ]
    },
    {
      "id": "norm.curly-quote-close",
      "priority": 22,
      "language_pairs": [
        [
          "en",
          "zh-Hans"
        ]
      ],
      "action": {
        "kind": "replace",
        "from": "”",
        "to": "\"",
        "whole_word": false
      },
      "samples": [
        {
          "input": "say hello” now",
          "expect": "say hello\" now",
          "source": "en",
          "target": "zh-Hans"
        }
      ]
    },
