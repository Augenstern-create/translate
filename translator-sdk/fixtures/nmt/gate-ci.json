{
  "schema": "p33-ci-gate/v1",
  "purpose": "CI 里只判'有没有坏掉'的宽松上限。不用于跨机器比较，也不替代 fixtures/nmt/baseline-p33-*.json 的性能验收。",
  "rationale": [
    "基线来自共享的 i5-8250U；CI runner 的 CPU 不同，跨机器比较延迟无意义（docs/20 D-41）",
    "上限按实测值的 10x~1000x 量级设置：只为抓住数量级退化（例如 BLAS 线程超订、误开 debug 构建）",
    "只约束 RSS，不约束 PSS：部分容器没有 /proc/<pid>/smaps_rollup"
  ],
  "units": {
    "init_ms": "毫秒",
    "first_translate_ms": "毫秒",
    "lookup_*_ms.p50/p99": "毫秒",
    "ipc_rtt_ms.p50/p95": "毫秒",
    "*.rss_mib": "MiB"
  },
  "cases": {
    "empty": {
      "limits": [
        { "metric": "init_ms", "max": 50, "measured_on_dev": 0.01 },
        { "metric": "first_translate_ms", "max": 100, "measured_on_dev": 0.03 },
        { "metric": "self.rss_mib", "max": 64, "measured_on_dev": 3.16 }
      ]
    },
    "dictionary": {
      "limits": [
        { "metric": "init_ms", "max": 200, "measured_on_dev": 0.32 },
        { "metric": "lookup_crate_ms.p50", "max": 2.0, "measured_on_dev": 0.02 },
        { "metric": "lookup_facade_ms.p50", "max": 5.0, "measured_on_dev": 0.18 },
        { "metric": "lookup_facade_ms.p99", "max": 20.0, "measured_on_dev": 0.22 },
        { "metric": "self.rss_mib", "max": 256, "measured_on_dev": 6.75 }
      ]
    },
    "worker": {
      "limits": [
        { "metric": "ipc_rtt_ms.p50", "max": 5.0, "measured_on_dev": 0.04 },
        { "metric": "ipc_rtt_ms.p95", "max": 25.0, "measured_on_dev": 0.07 },
        { "metric": "tree.rss_mib", "max": 128, "measured_on_dev": 5.71 }
      ]
    }
  },
  "not_gated": [
    "模型加载与热翻译：需要真实权重，默认门禁里没有权重（红线）",
    "并发与长时间稳定性：跑一次 10 分钟，不适合每次提交",
    "质量：需要真实模型，且可读性必须人工评分"
  ]
}
